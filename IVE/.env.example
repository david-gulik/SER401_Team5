# ---------------------------------------------------------------
# IVE / GAVEL environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored and will never be committed.
# ---------------------------------------------------------------

# -- General ---------------------------------------------------
# Workspace root. Every course is downloaded into
# <root>/courses/<course folder>/ (see docs/workspace_layout.md).
# Starting value on the Download page; the CLI --workspace flag overrides it.
# DEFAULT_OUTPUT_DIR=~/Downloads/GAVEL

# -- Canvas ----------------------------------------------------
# CANVAS_BASE_URL=https://canvas.asu.edu
# CANVAS_TOKEN=your_canvas_api_token_here

# -- ASU Login -------------------------------------------------
# "true"  keeps the browser's ASU login between runs, so the roster and
#         Gradescope downloads ask for Duo less often. The login cookies
#         are saved in your user profile, outside this project folder.
# "false" signs in fresh each time the app starts and deletes any saved
#         login. Use it on a shared computer.
# ASU_LOGIN_REMEMBER=true

# -- ASU Roster ------------------------------------------------
# Auth method: "selenium" (opens browser for CAS + Duo MFA)
#              "cookies"  (uses exported cookie file, no browser)
# ROSTER_AUTH_METHOD=selenium

# Path to Netscape-format cookie file (required when auth=cookies)
# ROSTER_COOKIE_FILE=cookies.txt

# Pre-existing catalog API Bearer token (optional, skips Selenium
# for class lookup). Copy from browser dev tools on catalog.apps.asu.edu.
# ROSTER_TOKEN=

# -- ASU Roster timeouts (seconds) ----------------------------
# Time for user to complete CAS + Duo MFA in the browser
# (applies to every download that signs in to ASU)
# ROSTER_MFA_TIMEOUT=120

# How long a cached session stays valid before re-authentication
# ROSTER_SESSION_TTL=600

# Timeout for individual HTTP requests (API calls, roster downloads)
# ROSTER_HTTP_TIMEOUT=30

# Time to wait for the catalog domain to load before seeding PKCE params
# ROSTER_PAGE_LOAD_TIMEOUT=30

# Time for the catalog SPA to exchange an OAuth code for a JWT
# ROSTER_TOKEN_EXCHANGE_TIMEOUT=30

# Submissions folder for gradescope_client bulk downloads
# SUBMISSIONS_FOLDER=

# Gradescope Base URL
# GRADESCOPE_BASE_URL=https://www.gradescope.com

# Gradescope Courses URL Suffix
# GRADESCOPE_COURSES_SUFFIX=/courses

# Gradescope Assignments URL Suffix
# GRADESCOPE_ASSIGNMENTS_SUFFIX=/assignments

# Gradescope Review Grades URL Suffix
# GRADESCOPE_REVIEW_GRADES_SUFFIX=/review_grades

# Gradescope Generated Files URL Suffix
# GRADESCOPE_GENERATED_FILES_SUFFIX=/generated_files

# Canvas Login Info
# CANVAS_USERNAME=
# CANVAS_PASSWORD=